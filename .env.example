# Public URL of the app (used in Stripe redirects, pass links and invite links)
APP_URL="http://localhost:3000"

# Long random strings. Generate each with: openssl rand -base64 48
# SESSION_SECRET signs staff sessions (rotating it signs everyone out).
SESSION_SECRET=""
# QR_SECRET signs boarding-pass QR codes (rotating it invalidates every issued pass!).
QR_SECRET=""

# Google accounts allowed to become Owner on their first sign-in (comma-separated)
OWNER_EMAILS="you@example.com"

# Firebase Admin service account: Firebase console → Project settings → Service accounts
# → Generate new private key. Paste the JSON on one line, or base64-encode it.
FIREBASE_SERVICE_ACCOUNT=""

# Stripe: booking link /book/1 charges account 1, /book/2 charges account 2.
# Staff payment links charge the Stripe account of the booking's partner.
STRIPE_SECRET_KEY_1=""
STRIPE_WEBHOOK_SECRET_1=""
STRIPE_SECRET_KEY_2=""
STRIPE_WEBHOOK_SECRET_2=""

# Optional: email tickets automatically via Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Tripcelona <tickets@tripcelona.com>"
