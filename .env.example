# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public base URL where this applet is hosted (e.g. https://my-app.run.app or http://localhost:3000).
# Used for Stripe Checkout success_url, cancel_url, and webhook callbacks.
APP_URL="http://localhost:3000"

# Stripe Account 1 Secrets (Used when booking via /book/1)
# Secret API key from Stripe Dashboard for Account 1 (starts with sk_live_... or sk_test_...)
STRIPE_SECRET_KEY_1=""
# Webhook signing secret from Stripe Dashboard for Account 1 endpoint (starts with whsec_...)
STRIPE_WEBHOOK_SECRET_1=""

# Stripe Account 2 Secrets (Used when booking via /book/2)
# Secret API key from Stripe Dashboard for Account 2 (starts with sk_live_... or sk_test_...)
STRIPE_SECRET_KEY_2=""
# Webhook signing secret from Stripe Dashboard for Account 2 endpoint (starts with whsec_...)
STRIPE_WEBHOOK_SECRET_2=""
