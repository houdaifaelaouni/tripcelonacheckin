rules_version = '2';

// Tripcelona Check-in v2: the browser never talks to Firestore directly.
// All reads and writes go through the server (Firebase Admin SDK), which
// bypasses these rules and enforces roles itself. So: deny everything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
